{
    "framework": "mindspore",
    "exp": "mindspore_synthetic",
    "dataset": "synthetic",
    "model_name": "quan_adapter",
    "backbone_type": "vit_base_patch16_224_in21k_quan_adapter",
    "prefix": "quan_adapter",
    "pretrained": false,
    "shuffle": false,

    "init_cls": 3,
    "increment": 3,
    "max_tasks": 2,
    "synthetic_classes": 6,
    "synthetic_train_per_class": 4,
    "synthetic_test_per_class": 4,
    "max_samples_per_class": 4,

    "epochs": 1,
    "quantum_epochs": 1,
    "crct_epochs": 1,
    "batch_size": 2,
    "num_workers": 0,
    "init_lr": 0.01,
    "weight_decay": 0.0005,
    "min_lr": 0.0,
    "optimizer": "sgd",
    "scheduler": "cosine",
    "ca_lr": 0.005,
    "ca_samples_per_class": 4,
    "ca_storage_efficient_method": "variance",
    "n_centroids": 2,
    "clip_norm": 1.0,

    "img_size": 64,
    "patch_size": 16,
    "embed_dim": 96,
    "depth": 2,
    "num_heads": 4,
    "mlp_ratio": 2.0,
    "ffn_num": 8,
    "ffn_option": "parallel",
    "ffn_adapter_init_option": "lora",
    "ffn_adapter_scalar": "0.1",
    "ffn_adapter_layernorm_option": "none",
    "drop": 0.0,
    "attn_drop": 0.0,
    "drop_path": 0.0,

    "n_qubits": 3,
    "quantum_layers": 1,
    "quantum_fit_samples": 64,
    "svd_dim": 6,
    "svd_random_state": 1993,
    "quantum_measure": "pqk",
    "save_reduced_states": true,
    "use_soft_routing": false,
    "soft_routing_temperature": 1.0,
    "use_distillation": true,
    "lambda_kd": 0.5,
    "kd_temperature": 1.0,

    "device": "npu:0",
    "device_target": "ascend",
    "ms_mode": "pynative",
    "seed": 1993,
    "topk": 3,
    "save_checkpoint": false,
    "output_dir": "results",
    "log_dir": "logs"
}
