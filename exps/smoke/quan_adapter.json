{
    "prefix": "quan_adapter",
    "dataset": "cifar224",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 10,
    "increment": 10,
    "model_name": "quan_adapter",
    "backbone_type": "vit_base_patch16_224_in21k_quan_adapter",
    "device": ["npu:0"],
    "backend": "npu",
    "num_workers": 0,
    "seed": [1993],

    "epochs": 1,
    "init_lr": 0.01,
    "batch_size": 4,
    "weight_decay": 0.0005,
    "min_lr": 0,
    "optimizer": "sgd",
    "scheduler": "cosine",
    "init_milestones": [10],
    "init_lr_decay": 0.1,

    "pretrained": false,
    "drop": 0.0,
    "drop_path": 0.0,
    "ffn_num": 16,

    "n_qubits": 3,
    "quantum_layers": 1,
    "quantum_epochs": 1,
    "quantum_device": "auto",

    "svd_dim": 6,
    "quantum_measure": "pqk",
    "save_reduced_states": true,
    "svd_random_state": 1993,

    "use_soft_routing": false,
    "soft_routing_temperature": 1.0,

    "crct_epochs": 1,
    "ca_lr": 0.005,
    "ca_storage_efficient_method": "covariance",
    "ca_storage_efficient_method_choices": ["covariance", "multi-centroid", "variance"],
    "n_centroids": 2,

    "use_distillation": true,
    "lambda_kd": 1.0,
    "lambda_sparse": 0.05,
    "kd_temperature": 1.0,

    "max_tasks": 1,
    "max_samples_per_class": 8,
    "print_forget": true
}
