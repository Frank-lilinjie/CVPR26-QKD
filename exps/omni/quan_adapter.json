{
    "prefix": "quan_adapter",
    "dataset": "omnibenchmark",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 30,
    "increment": 30,
    "model_name": "quan_adapter",
    "backbone_type": "vit_base_patch16_224_in21k_quan_adapter",
    "device": ["0"],
    "seed": [1993],

    "epochs": 10,
    "init_lr": 0.01,
    "batch_size": 16,
    "weight_decay": 0.0005,
    "min_lr": 0,
    "optimizer": "sgd",
    "scheduler": "cosine",
    "init_milestones": [10],
    "init_lr_decay": 0.1,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,
    "ffn_num": 16,

    "identifier_type": "quantum",
    "use_pqk": false,
    "n_projectors": 4,
    "rbf_gamma": 1.0,
    "learnable_gamma": true,
    "n_qubits": 3,
    "quantum_layers": 3,
    "identifier_layers": 3,
    "hidden_dim": 256,
    "num_heads": 8,
    "quantum_epochs": 10,
    "anchors_per_task": 5,
    "ema_decay": 0.99,

    "crct_epochs": 30,
    "ca_lr": 0.005,
    "ca_storage_efficient_method": "covariance", 
    "ca_storage_efficient_method_choices": ["covariance", "multi-centroid", "variance"],
    "n_centroids": 10,

    "print_forget": true
}